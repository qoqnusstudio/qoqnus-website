// Prisma schema for QOQNUS Media Studio
// docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum VideoPlatform {
  YOUTUBE
  APARAT
}

model Article {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String?
  content     String
  coverImage  String?
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([published, publishedAt])
}

model Project {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String
  tag         String?
  coverImage  String?
  coverVideo  String?
  order       Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, order])
}

model Video {
  id          String        @id @default(cuid())
  title       String
  description String?
  platform    VideoPlatform
  url         String
  order       Int           @default(0)
  published   Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([published, order])
}

// Optional editorial blocks an admin can slot between the site's fixed
// sections on a given page (by position), or publish as a standalone
// page at /[slug] when targetPage is "standalone".
model Section {
  id         String   @id @default(cuid())
  title      String
  slug       String   @unique
  content    String
  coverImage String?
  embedUrl   String?
  targetPage String
  position   Int      @default(0)
  status     String   @default("draft")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([targetPage, status, position])
}

// Forum member account — deliberately separate from the single
// env-var-based admin login in auth.ts. Regular members register and
// sign in with these, while site-admin moderation powers (pin/lock/
// delete anything) still gate on the existing admin session.
model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  banned       Boolean  @default(false)
  createdAt    DateTime @default(now())

  topics  ForumTopic[]
  replies ForumReply[]
}

model ForumTopic {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  content   String
  category  String   @default("general")
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  pinned    Boolean  @default(false)
  locked    Boolean  @default(false)
  flagged   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  replies ForumReply[]

  @@index([category, pinned, createdAt])
}

model ForumReply {
  id        String   @id @default(cuid())
  content   String
  authorId  String
  author    User       @relation(fields: [authorId], references: [id])
  topicId   String
  topic     ForumTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  flagged   Boolean    @default(false)
  createdAt DateTime   @default(now())

  @@index([topicId, createdAt])
}
