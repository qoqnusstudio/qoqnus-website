# Copy this file to .env and fill in real values. Never commit .env.

# Database connection, via @libsql/client (works for both):
# - Local dev: a plain local SQLite file — DATABASE_AUTH_TOKEN unused.
DATABASE_URL="file:./dev.db"
# - Production (e.g. Vercel): a Turso database — file storage isn't
#   persistent on serverless hosts, so production needs a real remote
#   libSQL/Turso database instead. Get both from turso.tech (free tier,
#   no credit card): DATABASE_URL="libsql://<db>-<org>.turso.io"
DATABASE_AUTH_TOKEN=""

# Fixed admin credentials for the /admin panel.
# ADMIN_PASSWORD_HASH is a base64-encoded bcrypt hash, NOT the plain
# password (base64, because a raw bcrypt hash contains "$", which
# Next.js's .env loader misreads as variable-expansion syntax).
# Generate it with: npm run hash-password -- "your-plain-password"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD_HASH=""

# Random secret used to sign admin session cookies (JWT).
# Generate one with: openssl rand -hex 32
SESSION_SECRET=""

# Cover image uploads (Section/Article/Project admin forms) go to
# Netlify Blobs. On a deployed Netlify site this needs no config —
# it auto-detects its store from the request context. For local dev
# (`npm run dev` without the Netlify CLI) there is no such context,
# so uploads there need a Personal Access Token + your site's ID:
#   NETLIFY_SITE_ID    — Project configuration → General → Site details
#   NETLIFY_AUTH_TOKEN — User settings → Applications → New access token
# Leave both empty if you don't need to test uploads locally.
NETLIFY_SITE_ID=""
NETLIFY_AUTH_TOKEN=""

# Kill switch for the 3D hero prototype (the gold camera-on-tripod
# that replaced the particle animation). If it doesn't work out, set
# this to "false" in Netlify's Environment Variables and trigger a
# new deploy — every visitor reverts to the original particle
# animation immediately, no code change or rollback needed. Leave
# unset (or "true") to keep the 3D version.
NEXT_PUBLIC_HERO_3D_ENABLED="true"
