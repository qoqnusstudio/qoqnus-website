# Copy this file to .env and fill in real values. Never commit .env.

# SQLite database file used by Prisma (see prisma.config.ts)
DATABASE_URL="file:./dev.db"

# Fixed admin credentials for the /admin panel.
# ADMIN_PASSWORD_HASH is a bcrypt hash, NOT the plain password.
# Generate one with: npm run hash-password -- "your-plain-password"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD_HASH=""

# Random secret used to sign admin session cookies (JWT).
# Generate one with: openssl rand -hex 32
SESSION_SECRET=""
