# Copy this file to .env and fill in real values. Never commit .env.

# Database connection, via @libsql/client (works for both):
# - Local dev: a plain local SQLite file — DATABASE_AUTH_TOKEN unused.
DATABASE_URL="file:./dev.db"
# - Production (e.g. Vercel): a Turso database — file storage isn't
#   persistent on serverless hosts, so production needs a real remote
#   libSQL/Turso database instead. Get both from turso.tech (free tier,
#   no credit card): DATABASE_URL="libsql://<db>-<org>.turso.io"
DATABASE_AUTH_TOKEN=""

# Fixed admin credentials for the /admin panel.
# ADMIN_PASSWORD_HASH is a base64-encoded bcrypt hash, NOT the plain
# password (base64, because a raw bcrypt hash contains "$", which
# Next.js's .env loader misreads as variable-expansion syntax).
# Generate it with: npm run hash-password -- "your-plain-password"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD_HASH=""

# Random secret used to sign admin session cookies (JWT).
# Generate one with: openssl rand -hex 32
SESSION_SECRET=""
